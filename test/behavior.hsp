; Exercise both sides of conditionals, including statements after a block.
*main
repeat 2
flag=cnt
foo=0:baz=0
if (flag) { foo=7:baz=1 }
mes str(foo)+","+str(baz)
if flag { foo=9 } : baz=3
mes str(foo)+","+str(baz)
if flag : foo=2:baz=4
mes str(foo)+","+str(baz)
loop
x=0
while x<3
x+=1
wend
for i,0,2
x+=i
next
do
x-=1
until x=2
switch x
case 2
mes "switch ok"
swbreak
default
mes "switch bad"
swend
mes $00ff+%0010
mes 0x00ff+0b0010
mes 1.0e-2
repeat 2,1
mes cnt
loop
repeat ,1
mes cnt
break
loop
while
_break
wend
if ((x=2)) : mes "parentheses ok"
probe_a=6:probe_b=3
mes probe_a&probe_b
mes probe_a&&probe_b
mes probe_a|probe_b
mes probe_a||probe_b
mes probe_a!probe_b
mes probe_a!=probe_b
mes probe_a=probe_b
mes probe_a==probe_b
probe_equal=probe_a=probe_b
mes probe_equal
dim probe_array,2
probe_array(0)=1:probe_array(1)=3
probe_array(0)+:probe_array(1)--
mes probe_array(0),probe_array(1)
probe_array.0++:probe_array.(1)-
mes probe_array(0),probe_array(1)
probe_a+:probe_a++:probe_b-:probe_b--
mes probe_a,probe_b
probe_a&=3:probe_b|=2
mes probe_a,probe_b
probe_hits@fmt_module=0
mes 0&&fmt_probe()
mes probe_hits@fmt_module
mes 1||fmt_probe()
mes probe_hits@fmt_module
mes "operator text: && || != == ++ --"
/* standalone
 block comment */
fmt_report
mes fmt_increment(4)
gosub *report
mes "hspfmt integration ok"
end

*report
mes "label ok" ; trailing comment
return

/* module documentation
 stays with the declaration */
#module fmt_module
; command documentation
; second documentation line
#deffunc fmt_report
mes "function ok"
return

; function documentation
#defcfunc fmt_increment int p_value
return p_value+1

#defcfunc fmt_probe
probe_hits++
return 1
#global
