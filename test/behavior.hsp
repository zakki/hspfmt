; Exercise both sides of conditionals, including statements after a block.
*main
repeat 2
flag=cnt
foo=0:baz=0
if (flag) { foo=7:baz=1 }
mes str(foo)+","+str(baz)
if flag { foo=5 }
else { foo=6 }
mes foo
if flag { foo=9 } : baz=3
mes str(foo)+","+str(baz)
if flag : foo=2:baz=4
mes str(foo)+","+str(baz)
loop
x=0
while x<3
x+=1
wend
for i,0,2
x+=i
next
do
x-=1
until x=2
switch x
case 2
mes "switch ok"
swbreak
default
mes "switch bad"
swend
mes $00ff+%0010
mes 0x00ff+0b0010
mes 1.0e-2
mes 1d
mes 2D
mes 1.25d
mes 2.5D
mes %_0010
mes %__10_01
mes %_1010L
mes 0b_0010
mes 0b__10_01
repeat 2,1
mes cnt
loop
repeat ,1
mes cnt
break
loop
while
_break
wend
if ((x=2)) : mes "parentheses ok"
probe_a=6:probe_b=3
mes probe_a&probe_b
mes probe_a&&probe_b
mes probe_a|probe_b
mes probe_a||probe_b
mes probe_a!probe_b
mes probe_a!=probe_b
mes probe_a=probe_b
mes probe_a==probe_b
probe_equal=probe_a=probe_b
mes probe_equal
dim probe_array,2
probe_array(0)=1:probe_array(1)=3
probe_array(0)+:probe_array(1)--
mes probe_array(0),probe_array(1)
probe_array.0++:probe_array.(1)-
mes probe_array(0),probe_array(1)
probe_a+:probe_a++:probe_b-:probe_b--
mes probe_a,probe_b
probe_a&=3:probe_b|=2
mes probe_a,probe_b
probe_hits@fmt_module=0
mes 0&&fmt_probe()
mes probe_hits@fmt_module
mes 1||fmt_probe()
mes probe_hits@fmt_module
mes "operator text: && || != == ++ --"
; Bare multiplication assignments share syntax with label-taking commands.
probe_factor=2
probe_factor*3
mes probe_factor
probe_factor * 2
mes probe_factor
/* standalone
 block comment */
fmt_report
mes fmt_increment(4)
gosub *report
on (0*2) gosub *report,*report
probe_label = *report
gosub probe_label
ldim probe_labels,2
probe_labels(0)=*report:probe_labels.1=*report
gosub probe_labels(0)
gosub probe_labels.1
; User-defined commands/functions accept labels in multiple argument positions.
fmt_call_labels *report,2*3,*report
mes fmt_label_value(*report,fmt_label_value(*report,2*3,*report),*report)+1
fmt_local_labels@fmt_module *report,2*3,*report
mes fmt_local_label_value@fmt_module(*report,2*3)+1
mes fmt_label_value(probe_label,2*3,probe_labels(0))
; Compile event label references without registering handlers in HSPCL.
if 0 {
onclick gosub *report
onclick gosub probe_label
onkey goto *report
onexit gosub *report
onerror goto *report
oncmd gosub *report,100+2
button gosub "report",*report
}
mes "hspfmt integration ok"
end

*report
mes "label ok" ; trailing comment
return

/* module documentation
 stays with the declaration */
#module fmt_module
; command documentation
; second documentation line
#deffunc fmt_report
mes "function ok"
return

; function documentation
#defcfunc fmt_increment int p_value
return p_value+1

#defcfunc fmt_probe
probe_hits++
return 1

#deffunc fmt_call_labels label p_first, int p_factor, label p_last
gosub p_first
mes p_factor
gosub p_last
return

#defcfunc fmt_label_value label p_first, int p_factor, label p_last
gosub p_first
gosub p_last
return p_factor

#deffunc local fmt_local_labels label p_first, int p_factor, label p_last
gosub p_first
mes p_factor
gosub p_last
return

#defcfunc local fmt_local_label_value label p_target, int p_factor
gosub p_target
return p_factor
#global
